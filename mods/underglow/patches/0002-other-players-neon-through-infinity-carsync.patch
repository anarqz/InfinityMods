diff --git a/src/ug_remote.h b/src/ug_remote.h
new file mode 100644
index 0000000..4d2c37c
--- /dev/null
+++ b/src/ug_remote.h
@@ -0,0 +1,179 @@
+// Underglow on the other players' cars (Infinity: CR-L53, OD-248): the pure parts, without the game or Windows, so a
+// host test can check them (InfinityMods mods/underglow/tests).
+//
+// - The blob: the local car's look in 40 bytes (Underglow blob, sync id 1, layout version 1), given to the Infinity
+//   hook's car-state sync and read back on the other players' PCs. Big-endian, as the rest of the wire.
+//
+//   byte  0      flags: bit 0 the neon is on
+//         1      the lit parts, bit z: 0 front, 1 right, 2 rear, 3 left (switched on and on the car's kit)
+//         2      the LED level, 1..3
+//         3      0
+//         4..7   the primary color, RGB8;   7..10 the secondary
+//         10..14 the effect of each zone (front, right, rear, left)
+//         14..16 brightness u16, 1/1000;    16..18 speed u16, 1/1000 cycles a second
+//         18..21 Lv1 lights: side, front, rear
+//         21     0
+//         22..32 height, front inset, rear inset, side offset, side trim: i16 millimeters
+//         32..34 range u16 cm;  34..36 power u16, 1/100;  36, 37 inner, outer cone degrees
+//         38..40 0
+//
+//   A receiver checks every byte: a blob that breaks this shape is dropped (that car shows no neon). A later layout
+//   version (compatible additions only: the sync id changes for anything else) may be longer; its first 40 bytes
+//   are read as these and its reserved bytes are not checked. An effect this build doesn't know plays Static.
+//
+// - The cars: at most kMaxCars, the nearest within kMaxDistance meters of the player's car; kMaxLights lights each.
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+namespace ugr {
+
+const int kBlobSize = 40;
+const uint8_t kBlobVersion = 1;
+const int kMaxCars = 8;
+const float kMaxDistance = 150.0f;
+const int kMaxLights = 32;
+const int kMaxEdge = 64;   // Lv1 lights on one edge (the local neon's kMaxNeon)
+
+struct Style {
+    bool on = false;
+    uint8_t parts = 0;   // bit z: zone z lit
+    uint8_t led = 1;     // 1..3
+    uint8_t rgb[2][3] = {};
+    uint8_t effect[4] = {};
+    float brightness = 0.25f, speed = 0.3f;
+    int side = 10, front = 6, rear = 6;   // Lv1
+    float height = 0.01f, front_inset = 0.5f, rear_inset = 0.7f, side_offset = -0.2f, side_trim = 0.8f;
+    float range = 1.0f, power = 4.0f, inner = 60.0f, outer = 170.0f;
+};
+
+inline float clampf(float x, float lo, float hi) { return !(x >= lo) ? lo : x > hi ? hi : x; }   // NaN: lo
+inline int clampi(int x, int lo, int hi) { return x < lo ? lo : x > hi ? hi : x; }
+
+inline void put16(uint8_t* p, unsigned v) {
+    p[0] = uint8_t(v >> 8);
+    p[1] = uint8_t(v);
+}
+inline unsigned get16(const uint8_t* p) { return unsigned(p[0]) << 8 | p[1]; }
+inline unsigned q16(float x, float scale) { return unsigned(std::lround(double(clampf(x * scale, 0.0f, 65535.0f)))); }
+inline void put_mm(uint8_t* p, float meters) {
+    const long v = std::lround(double(clampf(meters * 1000.0f, -32768.0f, 32767.0f)));
+    put16(p, unsigned(uint16_t(int16_t(v))));
+}
+inline float get_mm(const uint8_t* p) { return float(int16_t(uint16_t(get16(p)))) / 1000.0f; }
+
+// The local car's look as the blob.
+inline void encode(const Style& s, uint8_t out[kBlobSize]) {
+    memset(out, 0, kBlobSize);
+    out[0] = s.on ? 1 : 0;
+    out[1] = s.parts & 0x0F;
+    out[2] = uint8_t(clampi(s.led, 1, 3));
+    memcpy(out + 4, s.rgb[0], 3);
+    memcpy(out + 7, s.rgb[1], 3);
+    memcpy(out + 10, s.effect, 4);
+    put16(out + 14, q16(s.brightness, 1000.0f));
+    put16(out + 16, q16(s.speed, 1000.0f));
+    out[18] = uint8_t(clampi(s.side, 0, kMaxEdge));
+    out[19] = uint8_t(clampi(s.front, 0, kMaxEdge));
+    out[20] = uint8_t(clampi(s.rear, 0, kMaxEdge));
+    put_mm(out + 22, s.height);
+    put_mm(out + 24, s.front_inset);
+    put_mm(out + 26, s.rear_inset);
+    put_mm(out + 28, s.side_offset);
+    put_mm(out + 30, s.side_trim);
+    put16(out + 32, q16(s.range, 100.0f));
+    put16(out + 34, q16(s.power, 100.0f));
+    out[36] = uint8_t(clampi(int(std::lround(double(clampf(s.inner, 0.0f, 180.0f)))), 0, 180));
+    out[37] = uint8_t(clampi(int(std::lround(double(clampf(s.outer, 0.0f, 180.0f)))), 0, 180));
+}
+
+// Another player's blob (`length` bytes, layout `version`), checked; false: no neon for that car. `effects`: how many
+// effects this build has. The numbers are kept to what a light can take (a hostile blob can't blow a light up).
+inline bool decode(const uint8_t* b, int length, uint8_t version, int effects, Style* out) {
+    if (!b || version < 1 || length < kBlobSize || length > 64 || (version == 1 && length != kBlobSize)) return false;
+    if (version == 1 && ((b[0] & ~1u) || b[3] || b[21] || b[38] || b[39])) return false;
+    if ((b[1] & 0xF0u) || b[2] < 1 || b[2] > 3 || b[18] > kMaxEdge || b[19] > kMaxEdge || b[20] > kMaxEdge ||
+        b[36] > 180 || b[37] > 180)
+        return false;
+    Style s;
+    s.on = b[0] & 1;
+    s.parts = b[1];
+    s.led = b[2];
+    memcpy(s.rgb[0], b + 4, 3);
+    memcpy(s.rgb[1], b + 7, 3);
+    for (int z = 0; z < 4; ++z) s.effect[z] = b[10 + z] < effects ? b[10 + z] : 0;
+    s.brightness = clampf(float(get16(b + 14)) / 1000.0f, 0.0f, 4.0f);
+    s.speed = clampf(float(get16(b + 16)) / 1000.0f, 0.0f, 10.0f);
+    s.side = b[18];
+    s.front = b[19];
+    s.rear = b[20];
+    s.height = clampf(get_mm(b + 22), -1.0f, 1.0f);
+    s.front_inset = clampf(get_mm(b + 24), -2.0f, 3.0f);
+    s.rear_inset = clampf(get_mm(b + 26), -2.0f, 3.0f);
+    s.side_offset = clampf(get_mm(b + 28), -1.0f, 1.0f);
+    s.side_trim = clampf(get_mm(b + 30), 0.0f, 3.0f);
+    s.range = clampf(float(get16(b + 32)) / 100.0f, 0.05f, 20.0f);
+    s.power = clampf(float(get16(b + 34)) / 100.0f, 0.0f, 50.0f);
+    s.inner = float(b[36]);
+    s.outer = float(b[37]);
+    if (s.inner > s.outer) s.inner = s.outer;
+    *out = s;
+    return true;
+}
+
+// The lights down each side, across the front and the back, cut to at most `max` in all (2 * side + front + rear),
+// each edge in proportion (Lv3's 20/12/12 is Lv1's 10/6/6 again); what rounding leaves goes to the front and the back.
+inline void cap_lights(int* side, int* front, int* rear, int max) {
+    *side = clampi(*side, 0, kMaxEdge);
+    *front = clampi(*front, 0, kMaxEdge);
+    *rear = clampi(*rear, 0, kMaxEdge);
+    const int total = 2 * *side + *front + *rear;
+    if (max < 0) max = 0;
+    if (total <= max) return;
+    const int s0 = *side, f0 = *front, r0 = *rear;
+    *side = s0 * max / total;
+    *front = f0 * max / total;
+    *rear = r0 * max / total;
+    int left = max - (2 * *side + *front + *rear);
+    while (left > 0) {
+        if (*front < f0 && (*front <= *rear || *rear >= r0)) ++*front, --left;
+        else if (*rear < r0) ++*rear, --left;
+        else if (left >= 2 && *side < s0) ++*side, left -= 2;
+        else break;
+    }
+}
+
+struct Candidate {
+    uintptr_t key;    // the car
+    float pos[3];     // where it is (world, meters)
+};
+
+// The nearest `max_out` candidates within `max_m` of `me`, nearest first (equal distances: the lower key first), as
+// indices into `c`; returns how many. Positions that aren't finite never count.
+inline int select_nearest(const Candidate* c, int n, const float me[3], float max_m, int max_out, int* out) {
+    int k = 0;
+    float dist[64];
+    if (max_out > 64) max_out = 64;
+    for (int i = 0; i < n; ++i) {
+        const float dx = c[i].pos[0] - me[0], dy = c[i].pos[1] - me[1], dz = c[i].pos[2] - me[2];
+        const float d2 = dx * dx + dy * dy + dz * dz;
+        if (!std::isfinite(d2) || d2 > max_m * max_m) continue;
+        // insertion into the sorted list, dropping what falls past max_out
+        int at = k;
+        while (at > 0 && (dist[at - 1] > d2 || (dist[at - 1] == d2 && c[out[at - 1]].key > c[i].key))) --at;
+        if (at >= max_out) continue;
+        const int last = k < max_out ? k : max_out - 1;
+        for (int j = last; j > at; --j) {
+            dist[j] = dist[j - 1];
+            out[j] = out[j - 1];
+        }
+        dist[at] = d2;
+        out[at] = i;
+        if (k < max_out) ++k;
+    }
+    return k;
+}
+
+} // namespace ugr
