+// ---- Infinity: the other players' neon (CR-L53, OD-248) ------------------------------------------------------
+//
+// At most ugr::kMaxCars of the other players' cars, the nearest within ugr::kMaxDistance meters of the player's,
+// each with at most ugr::kMaxLights lights. Their lights come from the one light manager the player's car is in, made
+// like the player's neon (detour_create, the tail light's key, a preset of our own each), so the beam presets used are
+// at most kMaxCars * kMaxLights on top of the player's neon, whatever the world holds. The game has no call to give a
+// light back that we know of, so a car that leaves range, whose blob is gone (the hook forgets it 5 s after its owner
+// stopped sending) or when the sync stops: its lights go dark and wait in its slot for the next car.
+
+struct RemoteNeon {
+    uintptr_t car = 0, pres = 0;   // the car shown (0: a free slot)
+    Reference ref;                  // its shape on the car, the player's light manager
+    uint64_t geo_tick = 0;
+    int want = 0;                   // lights its shape needs (at most ugr::kMaxLights)
+    int count = 0;                  // lights made (kept when the slot changes car)
+    uint32_t handle[ugr::kMaxLights];
+    uint32_t preset[ugr::kMaxLights];
+    float rgb[ugr::kMaxLights][3];
+    uint64_t shape_sig = 0;
+    bool lit = false;
+    Shape placed;
+    int placed_n = 0;
+};
+struct RemotePool {
+    uintptr_t manager = 0, beams = 0, glows = 0;
+    RemoteNeon slot[ugr::kMaxCars];
+    uint32_t spare = ~0u;
+    uint64_t last_frame = 0, info_tick = 0;
+    bool sync = false;   // the hook's sync runs (Info flags bit 0)
+};
+RemotePool g_rn;   // only under g_neon_lock
+
+bool remote_light_ok(const RemoteNeon& s, int i) {
+    uint32_t beam, glow, preset = ~0u;
+    uintptr_t rec;
+    return mapping_of(g_rn.manager, s.handle[i], &beam, &glow) && (rec = beam_record(g_rn.beams, beam)) &&
+           rd(rec + kRecPreset, &preset, 4) && preset == s.preset[i];
+}
+
+void remote_dark(RemoteNeon& s) {
+    for (int i = 0; i < s.count; ++i) g_orig_set_int(reinterpret_cast<void*>(g_rn.manager), s.handle[i], 0.0f);
+    s.lit = false;
+}
+
+void remote_release(RemoteNeon& s) {
+    if (s.lit) remote_dark(s);
+    s.car = s.pres = 0;
+    s.placed_n = 0;
+    s.geo_tick = 0;
+    s.shape_sig = 0;
+}
+
+// write_preset's, on the pool's beam system.
+bool remote_write_preset(const Shape& sh, uint32_t preset, uint32_t template_preset, const float rgb[3]) {
+    uintptr_t ours = beam_preset(g_rn.beams, preset);
+    uintptr_t tmpl = beam_preset(g_rn.beams, template_preset);
+    uint8_t b[kBeamPresetStride], keep[8];
+    if (!ours || !tmpl || !rd(tmpl, b, sizeof b) || !rd(ours + kPreUsers, keep, 8)) return false;
+    const float zero[2] = {0.0f, 0.0f};
+    memcpy(b + kPreUsers, keep, 8);
+    memcpy(b + kPreRgb, rgb, 12);
+    memcpy(b + kPreRange, &sh.range, 4);
+    memcpy(b + kPrePower, &sh.power, 4);
+    memcpy(b + kPreInner, &sh.inner, 4);
+    memcpy(b + kPreOuter, &sh.outer, 4);
+    memcpy(b + kPreThreshold, zero, 8);
+    return wr(ours + 0x10, b + 0x10, sizeof b - 0x10);
+}
+
+// Another player's look as the neon's settings: its colors as two custom colors, audio effects a steady glow, its
+// shape at its LED level, cut to ugr::kMaxLights.
+Config remote_config(const ugr::Style& s) {
+    Config c;
+    c.neon = s.on;
+    for (int k = 0; k < 3; ++k) {
+        c.custom[0][k] = float(s.rgb[0][k]) / 255.0f;
+        c.custom[1][k] = float(s.rgb[1][k]) / 255.0f;
+    }
+    c.color = kColorCount;
+    c.color2 = kColorCount + 1;
+    c.brightness = s.brightness;
+    c.speed = s.speed;
+    for (int z = 0; z < kZoneCount; ++z) {
+        const int e = s.effect[z] < kEffectCount ? s.effect[z] : kEffectStatic;
+        c.effect[z] = effect_is_audio(e) ? kEffectStatic : e;
+        c.part[z] = (s.parts >> z) & 1u;
+    }
+    Shape& sh = c.shape;
+    sh.side = s.side;
+    sh.front = s.front;
+    sh.rear = s.rear;
+    sh.height = s.height;
+    sh.front_inset = s.front_inset;
+    sh.rear_inset = s.rear_inset;
+    sh.side_offset = s.side_offset;
+    sh.side_trim = s.side_trim;
+    sh.range = s.range;
+    sh.power = s.power;
+    sh.inner = s.inner;
+    sh.outer = s.outer;
+    clamp_shape(sh);
+    scale_shape(sh, s.led);
+    ugr::cap_lights(&sh.side, &sh.front, &sh.rear, ugr::kMaxLights);
+    return c;
+}
+
+// A remote car's shape on the car, from its own lights (as remember_player does for the player's), or the game's
+// data for its model; false when it isn't in the player's light manager.
+bool remote_geometry(const Reference& player, uintptr_t pres, long ordinal, Reference* out) {
+    Reference r;
+    uintptr_t context = 0, manager = 0, asset = 0;
+    Vec inst;
+    size_t n = 0;
+    if (!vtable_is(pres, kCarPresVtables, 2) || !rdp(pres + kPresContext, &context) ||
+        !rdp(context + kContextManager, &manager) || manager != player.manager || !rdp(pres + kPresAsset, &asset) ||
+        !read_vec(asset + kAssetInstances, 8, 512, &inst, &n))
+        return false;
+    r.pres = pres;
+    r.manager = player.manager;
+    r.beams = player.beams;
+    r.glows = player.glows;
+    r.template_handle = player.template_handle;
+    r.template_preset = player.template_preset;
+    int seen = 0;
+    for (size_t i = 0; i < n; ++i) {
+        uintptr_t instance = 0;
+        float lp[3];
+        if (!rdp(inst.begin + i * 8, &instance) || !rd(instance + 0x10, lp, 12) || !finite(lp, 3)) continue;
+        if (!seen || std::fabs(lp[0]) > r.half_width) r.half_width = std::fabs(lp[0]);
+        if (!seen || lp[2] > r.front) r.front = lp[2];
+        if (!seen || lp[2] < r.rear) r.rear = lp[2];
+        ++seen;
+    }
+    if (const CarSize* size = car_size(ordinal)) {
+        if (!seen || r.front - r.rear < 0.6f * size->wheelbase) {
+            r.front = size->wheelbase * 0.5f;
+            r.rear = -size->wheelbase * 0.5f;
+            r.db_length = true;
+        }
+        if (!seen || r.half_width < 0.45f) {
+            r.half_width = (size->front_track < size->rear_track ? size->front_track : size->rear_track) * 0.5f - 0.15f;
+            r.db_width = true;
+        }
+    }
+    r.valid = true;
+    r.tick = GetTickCount64();
+    *out = r;
+    return true;
+}
+
+// Makes the lights the shown cars still need (detour_create: the game's light-creating thread, g_neon_lock held).
+void remote_build(const Reference& ref) {
+    if (g_rn.manager != ref.manager || g_rn.beams != ref.beams) return;
+    if (ref.template_handle >= kMaxHandles || g_handle_manager[ref.template_handle] != ref.manager) return;
+    void* mgr = reinterpret_cast<void*>(ref.manager);
+    const float rgb[3] = {0.0f, 0.0f, 0.0f};
+    const Shape sh;
+    bool made = false;
+    for (RemoteNeon& s : g_rn.slot) {
+        if (!s.car) continue;
+        while (s.count < s.want && s.count < ugr::kMaxLights) {
+            uint32_t p = g_rn.spare;
+            g_rn.spare = ~0u;
+            if (p == ~0u) {
+                p = reinterpret_cast<AllocPresetFn>(g_base + kAllocBeamPreset)(
+                    reinterpret_cast<void*>(ref.beams + kBeamPresetPool));
+                if (p == ~0u || !beam_preset(ref.beams, p)) return;   // the pool is used up: what's made stays
+                const uint32_t no_users[2] = {0, 0};
+                wr(beam_preset(ref.beams, p) + kPreUsers, no_users, 8);
+            }
+            if (!remote_write_preset(sh, p, ref.template_preset, rgb)) {
+                g_rn.spare = p;
+                return;
+            }
+            uint32_t h = ~0u, beam, glow;
+            g_orig_create(mgr, &h, g_handle_key[ref.template_handle], g_handle_index[ref.template_handle]);
+            if (h == ~0u || !mapping_of(ref.manager, h, &beam, &glow) || beam == ~0u) {
+                g_rn.spare = p;
+                return;
+            }
+            reinterpret_cast<AttachPresetFn>(g_base + kAttachPreset)(reinterpret_cast<void*>(ref.beams), beam, p);
+            g_orig_set_int(mgr, h, 0.0f);   // dark until its car's frame places it
+            const int i = s.count++;
+            s.handle[i] = h;
+            s.preset[i] = p;
+            memcpy(s.rgb[i], rgb, sizeof rgb);
+            s.shape_sig = 0;   // its preset gets the car's shape at the next frame
+            made = true;
+        }
+    }
+    if (made) {
+        const uint8_t one = 1;
+        wr(g_rn.beams + kBeamDirty, &one, 1);
+    }
+}
+
+bool car_rotation(uintptr_t pres, float world[16], float car_rot[4]) {
+    if (!vtable_is(pres, kCarPresVtables, 2) || !rd(pres + kPresWorld, world, 16 * sizeof(float)) || !finite(world, 16))
+        return false;
+    alignas(16) float q[4];
+    _mm_store_ps(q, reinterpret_cast<MatrixToQuatFn>(g_base + kMatrixToQuat)(world));
+    if (!finite(q, 4)) return false;
+    memcpy(car_rot, q, sizeof q);
+    return true;
+}
+
+void remote_glow_off(uint32_t handle) {
+    uint32_t beam, glow;
+    if (g_rn.glows && mapping_of(g_rn.manager, handle, &beam, &glow) && glow != ~0u)
+        reinterpret_cast<GlowIntensityFn>(g_base + kGlowSetIntensity)(reinterpret_cast<void*>(g_rn.glows), glow, 0.0f);
+}
+
+// One shown car's neon this frame (light thread, g_neon_lock held).
+void remote_car_frame(RemoteNeon& s, const ugr::Style& style, double secs) {
+    void* mgr = reinterpret_cast<void*>(g_rn.manager);
+    int kept = 0;   // lights the game took back are forgotten
+    for (int i = 0; i < s.count; ++i) {
+        if (remote_light_ok(s, i)) {
+            s.handle[kept] = s.handle[i];
+            s.preset[kept] = s.preset[i];
+            memcpy(s.rgb[kept], s.rgb[i], 12);
+            ++kept;
+        }
+    }
+    s.count = kept;
+    const Config c = remote_config(style);
+    const int want = total_lights(c.shape);
+    s.want = want;
+    if (s.count < want) g_remote_build.store(true);
+    if (!s.count) return;
+    alignas(16) float world[16], car_rot[4];
+    if (!car_rotation(s.pres, world, car_rot)) return;
+    const uint64_t shape_sig = fnv(&c.shape, sizeof c.shape);
+    const bool reshape = shape_sig != s.shape_sig;
+    bool dirty = false;
+    const float down[4] = {0.70710678f, 0.0f, 0.0f, 0.70710678f};
+    alignas(16) float rot[4];
+    qmul(car_rot, down, rot);
+    const int n = s.count < want ? s.count : want;
+    static Pixel px[ugr::kMaxLights];
+    int group_count[kEffectCount] = {};
+    for (int i = 0; i < n; ++i) {
+        zone_of(c.shape, i, &px[i]);
+        px[i].id = i;
+        px[i].gi = c.part[px[i].zone] ? group_count[c.effect[px[i].zone]]++ : 0;
+    }
+    for (int i = 0; i < n; ++i) {
+        const int gn = group_count[c.effect[px[i].zone]];
+        px[i].gn = gn > 0 ? gn : 1;
+        px[i].ring = (float(px[i].gi) + 0.5f) / float(px[i].gn);
+    }
+    for (int i = 0; i < s.count; ++i) {
+        const uint32_t h = s.handle[i];
+        if (i >= n) {
+            g_orig_set_int(mgr, h, 0.0f);
+            continue;
+        }
+        float rgb[3], level;
+        effect_now(c, c.effect[px[i].zone], px[i], secs, rgb, &level);
+        if (!c.part[px[i].zone]) level = 0.0f;
+        const float intensity = level > 0.01f ? c.brightness * level : 0.0f;
+        if (intensity == 0.0f && !reshape) memcpy(rgb, s.rgb[i], 12);
+        if (reshape) {
+            dirty |= remote_write_preset(c.shape, s.preset[i], s.ref.template_preset, rgb);
+            memcpy(s.rgb[i], rgb, 12);
+        } else if (std::fabs(rgb[0] - s.rgb[i][0]) + std::fabs(rgb[1] - s.rgb[i][1]) + std::fabs(rgb[2] - s.rgb[i][2]) >
+                   0.002f) {
+            uintptr_t p = beam_preset(g_rn.beams, s.preset[i]);
+            if (p && wr(p + kPreRgb, rgb, 12)) dirty = true;
+            memcpy(s.rgb[i], rgb, 12);
+        }
+        float local[3], w[3];
+        edge_point(s.ref, c.shape, i, local);
+        qrot(car_rot, local, w);
+        alignas(16) const float pos[4] = {world[12] + w[0], world[13] + w[1], world[14] + w[2], 1.0f};
+        g_orig_set_pos(mgr, h, pos);
+        g_orig_set_dir(mgr, h, rot);
+        g_orig_set_int(mgr, h, intensity);
+        remote_glow_off(h);
+    }
+    if (reshape) s.shape_sig = shape_sig;
+    if (dirty) {
+        const uint8_t one = 1;
+        wr(g_rn.beams + kBeamDirty, &one, 1);
+    }
+    s.placed = c.shape;
+    s.placed_n = n;
+    s.lit = true;
+}
+
+// Once a frame on the light thread, after the player's neon (g_neon_lock held): which cars to show, then each.
+void remote_frame(const Reference& ref) {
+    if (!g_cs_on.load(std::memory_order_acquire)) return;
+    const uint64_t now = GetTickCount64();
+    if (g_rn.manager != ref.manager || g_rn.beams != ref.beams) {   // another light manager: start over
+        g_rn = RemotePool{};
+        g_rn.manager = ref.manager;
+        g_rn.beams = ref.beams;
+        g_rn.glows = ref.glows;
+    }
+    g_rn.last_frame = now;
+    if (now - g_rn.info_tick >= 1000) {
+        CsInfo info{};
+        info.size = sizeof info;
+        g_rn.sync = g_cs.info(&info) > 0 && (info.flags & 1u);
+        g_rn.info_tick = now;
+    }
+    static RemoteCar cars[kMaxRemoteCars];
+    AcquireSRWLockShared(&g_rc_lock);
+    memcpy(cars, g_rc, sizeof cars);
+    ReleaseSRWLockShared(&g_rc_lock);
+
+    ugr::Candidate cand[kMaxRemoteCars];
+    int of[kMaxRemoteCars], nc = 0;
+    alignas(16) float world[16] = {}, me_rot[4];
+    const bool me = g_rn.sync && car_rotation(ref.pres, world, me_rot);
+    const float my_pos[3] = {world[12], world[13], world[14]};
+    for (int i = 0; me && i < kMaxRemoteCars; ++i) {
+        const RemoteCar& r = cars[i];
+        alignas(16) float w[16], q[4];
+        if (!r.car || !r.has || !r.style.on || !r.style.parts || now - r.seen > 250 || !car_rotation(r.pres, w, q))
+            continue;
+        cand[nc] = {r.car, {w[12], w[13], w[14]}};
+        of[nc++] = i;
+    }
+    int chosen[ugr::kMaxCars];
+    const int k = me ? ugr::select_nearest(cand, nc, my_pos, ugr::kMaxDistance, ugr::kMaxCars, chosen) : 0;
+
+    // Cars no longer chosen go dark and free their slot; the newly chosen take free ones.
+    for (RemoteNeon& s : g_rn.slot) {
+        bool keep = false;
+        for (int j = 0; j < k && s.car; ++j) keep |= cars[of[chosen[j]]].car == s.car && cars[of[chosen[j]]].pres == s.pres;
+        if (s.car && !keep) remote_release(s);
+    }
+    const double secs = double(g_game_us.load(std::memory_order_relaxed) % 86400000000ull) / 1e6;
+    for (int j = 0; j < k; ++j) {
+        const RemoteCar& r = cars[of[chosen[j]]];
+        RemoteNeon* s = nullptr;
+        for (RemoteNeon& t : g_rn.slot)
+            if (t.car == r.car) s = &t;
+        for (RemoteNeon& t : g_rn.slot)
+            if (!s && !t.car) s = &t;
+        if (!s) continue;   // can't happen: kMaxCars slots for at most kMaxCars cars
+        if (!s->car) {
+            s->car = r.car;
+            s->pres = r.pres;
+            s->geo_tick = 0;
+            s->shape_sig = 0;
+        }
+        if (now - s->geo_tick >= 1000) {   // its shape again once a second (a car swap under the same pointer)
+            if (!remote_geometry(ref, s->pres, r.ordinal, &s->ref)) {
+                remote_release(*s);
+                continue;
+            }
+            s->geo_tick = now;
+        }
+        remote_car_frame(*s, r.style, secs);
+    }
+}
+
+// At the beam upload (render thread, g_neon_lock held): placed again from where each car is now, as the player's
+// neon; all dark when the light thread stopped placing them (menus, loading).
+void remote_upload(uintptr_t system) {
+    if (!g_rn.beams || g_rn.beams != system) return;
+    const bool stale = GetTickCount64() - g_rn.last_frame > 250;
+    for (RemoteNeon& s : g_rn.slot) {
+        if (!s.lit) continue;
+        if (stale) {
+            remote_release(s);
+            continue;
+        }
+        alignas(16) float world[16], car_rot[4];
+        if (!s.placed_n || !car_rotation(s.pres, world, car_rot)) continue;
+        const float down[4] = {0.70710678f, 0.0f, 0.0f, 0.70710678f};
+        alignas(16) float rot[4];
+        qmul(car_rot, down, rot);
+        void* mgr = reinterpret_cast<void*>(g_rn.manager);
+        const int n = s.placed_n < s.count ? s.placed_n : s.count;
+        for (int i = 0; i < n; ++i) {
+            float local[3], w[3];
+            edge_point(s.ref, s.placed, i, local);
+            qrot(car_rot, local, w);
+            alignas(16) const float pos[4] = {world[12] + w[0], world[13] + w[1], world[14] + w[2], 1.0f};
+            g_orig_set_pos(mgr, s.handle[i], pos);
+            g_orig_set_dir(mgr, s.handle[i], rot);
+        }
+    }
+}
