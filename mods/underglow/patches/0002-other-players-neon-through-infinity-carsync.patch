@@ -51,6 +51,11 @@
 #include "neon_text.h"
 #include "ug_upgrade.h"
 #include "car_sizes.h"
+#include "ug_remote.h"   // Infinity: the other players' neon (CR-L53)
+// The Infinity hook's car-state sync API (MIT, vendored as it is from native/hook/include of Infinity Horizon):
+// its declarations and InfinityCarSync_Resolve (GetProcAddress only).
+#define INFINITY_CARSYNC_RESOLVER
+#include "infinity_carsync.h"
 
 #ifndef UNDERGLOW_VERSION
 #define UNDERGLOW_VERSION "0.0.0"
@@ -847,12 +852,173 @@ bool set_car_style(int which, int color, int zone, int effect) {
     return true;
 }
 
+// ---- Infinity: the other players' neon, through the Infinity hook's car-state sync (CR-L53, OD-248) -------------
+//
+// In an online free-roam world under Infinity, the hook (azimuth-tls.dll, or ExtraOptions.Infinity's winmm.dll)
+// exports InfinityCarSync_*: Underglow gives it the local car's look as one 40-byte blob (ug_remote.h) and reads back
+// the blobs of the other players' cars that have Underglow too (the hook and the world pass a blob only between two
+// players who both have it). Found at run time with GetProcAddress only: without the hook, or with another version of
+// its API, nothing here runs and Underglow is what it always was.
+
+const uint32_t kCarSyncAbi = INFINITY_CARSYNC_VERSION;
+const uint8_t kCarSyncId = INFINITY_CARSYNC_ID_UNDERGLOW;   // the registry's id of Underglow (MATCHMAKING_API §5f)
+const int32_t kCarSyncOk = INFINITY_CARSYNC_OK;
+const int kCarSyncTries = 12;        // looked for when the player's car first drives, then every 5 s for a minute
+InfinityCarSyncApi g_cs;             // written once, before g_cs_on
+std::atomic<bool> g_cs_on{false};
+SRWLOCK g_cs_game_lock = SRWLOCK_INIT;   // the player's side below (resolve, publish): one thread at a time
+
+// An audio effect on another player's car: the receiver's radio isn't the sender's, so it shows a steady glow.
+bool effect_is_audio(int effect) {
+    for (const auto& e : kEffectOrder)
+        if (e.effect == effect) return e.group == kGroupAudio;
+    return false;
+}
+
+uint8_t rgb8(float x) { return uint8_t(std::lround(double(clamp01(x)) * 255.0)); }
+
+// The local car's look now, as the neon_frame shows it: the parts switched on and on its kit, its LED level, the
+// colors and effects of the car being driven.
+ugr::Style local_style() {
+    const Config c = car_config();
+    const int kit = kit_parts(c);
+    ugr::Style s;
+    s.on = c.neon;
+    s.parts = 0;
+    for (int z = 0; z < kZoneCount; ++z)
+        if (c.part[z] && kit_has(kit, z)) s.parts |= uint8_t(1u << z);
+    s.led = uint8_t(led_level(c));
+    float rgb[3];
+    for (int which = 0; which < 2; ++which) {
+        color_rgb(c, which ? c.color2 : c.color, rgb);
+        for (int k = 0; k < 3; ++k) s.rgb[which][k] = rgb8(rgb[k]);
+    }
+    for (int z = 0; z < kZoneCount; ++z) s.effect[z] = uint8_t(c.effect[z]);
+    s.brightness = c.brightness;
+    s.speed = c.speed;
+    s.side = c.shape.side;
+    s.front = c.shape.front;
+    s.rear = c.shape.rear;
+    s.height = c.shape.height;
+    s.front_inset = c.shape.front_inset;
+    s.rear_inset = c.shape.rear_inset;
+    s.side_offset = c.shape.side_offset;
+    s.side_trim = c.shape.side_trim;
+    s.range = c.shape.range;
+    s.power = c.shape.power;
+    s.inner = c.shape.inner;
+    s.outer = c.shape.outer;
+    return s;
+}
+
+// The player's car's update (the game's thread): find the API, then hand the hook the look whenever it changed (looked
+// at every 100 ms; the hook sends at most 10 a second and drops an unchanged blob anyway).
+void cs_player_car() {
+    static int tries = 0;               // all of these under g_cs_game_lock
+    static uint64_t next_try = 0, next_look = 0;
+    static uint8_t last[ugr::kBlobSize];
+    static bool published = false;
+    if (!TryAcquireSRWLockExclusive(&g_cs_game_lock)) return;
+    const uint64_t now = GetTickCount64();
+    if (!g_cs_on.load(std::memory_order_acquire) && tries < kCarSyncTries && now >= next_try) {
+        ++tries;
+        next_try = now + 5000;
+        InfinityCarSyncApi api;
+        if (InfinityCarSync_Resolve(&api)) {
+            const int32_t r = api.Register(kCarSyncAbi, kCarSyncId, ugr::kBlobVersion);
+            tries = kCarSyncTries;   // found: no more looking, whatever Register says
+            if (r == kCarSyncOk) {
+                // An "off" blob at once, and a blob always after it (never withdrawn): the world passes the other
+                // players' blobs only to a hook that sends one itself, so a car with its neon off still sees theirs.
+                uint8_t off[ugr::kBlobSize];
+                ugr::Style none;
+                none.on = false;
+                none.parts = 0;
+                ugr::encode(none, off);
+                api.Publish(kCarSyncId, off, sizeof off);
+                g_cs = api;
+                g_cs_on.store(true, std::memory_order_release);
+                g_api->log(g_mod, "the Infinity hook's car-state sync is here: the other players' Underglow shows on "
+                                  "their cars, and this car's on theirs");
+            } else {
+                char msg[128];
+                snprintf(msg, sizeof msg, "the Infinity hook's car-state sync refused Underglow (%d): this car only",
+                         int(r));
+                g_api->log(g_mod, msg);
+            }
+        }
+    }
+    if (g_cs_on.load(std::memory_order_acquire) && now >= next_look) {
+        next_look = now + 100;
+        uint8_t blob[ugr::kBlobSize];
+        ugr::encode(local_style(), blob);
+        if ((!published || memcmp(blob, last, sizeof blob)) && g_cs.Publish(kCarSyncId, blob, sizeof blob) == kCarSyncOk) {
+            memcpy(last, blob, sizeof blob);
+            published = true;
+        }
+    }
+    ReleaseSRWLockExclusive(&g_cs_game_lock);
+}
+
+// The other players' cars the game updates, with the look the hook has for each: read by the
+// neon on the light thread.
+struct RemoteCar {
+    uintptr_t car = 0, pres = 0;
+    long ordinal = 0;      // Data_Car.Id (car_sizes.h)
+    uint64_t seen = 0;     // its last update
+    bool has = false;      // a blob that checked out
+    ugr::Style style;
+};
+const int kMaxRemoteCars = 32;
+SRWLOCK g_rc_lock = SRWLOCK_INIT;
+RemoteCar g_rc[kMaxRemoteCars];
+
+void cs_remote_car(uintptr_t c) {
+    uintptr_t pres = 0;
+    if (!rdp(c + kForzaCarPresOffset, &pres)) return;
+    if (vtable_is(pres, &kDeferredPresVtable, 1) && !rdp(pres + kDeferredPresOffset, &pres)) return;
+    if (!vtable_is(pres, kCarPresVtables, 2)) return;
+    uint8_t buf[64];
+    uint8_t version = 0;
+    const int32_t n = g_cs.Get(reinterpret_cast<const void*>(c), kCarSyncId, buf, sizeof buf, &version);
+    RemoteCar r;
+    r.car = c;
+    r.pres = pres;
+    int id = 0;
+    if (rd(c + kForzaCarIdOffset, &id, 4) && id > 0 && id < 100000) r.ordinal = id;
+    r.seen = GetTickCount64();
+    r.has = n > 0 && ugr::decode(buf, int(n), version, kEffectCount, &r.style);
+    AcquireSRWLockExclusive(&g_rc_lock);
+    int at = -1, oldest = 0;
+    for (int i = 0; i < kMaxRemoteCars && at < 0; ++i)
+        if (g_rc[i].car == c) at = i;
+    if (at < 0 && !r.has) {   // traffic and AI (no blob, not listed): never take a place from a player's car
+        ReleaseSRWLockExclusive(&g_rc_lock);
+        return;
+    }
+    for (int i = 0; i < kMaxRemoteCars && at < 0; ++i)
+        if (g_rc[i].seen < g_rc[oldest].seen) oldest = i;
+    g_rc[at >= 0 ? at : oldest] = r;
+    ReleaseSRWLockExclusive(&g_rc_lock);
+}
+
+void cs_car(void* car) {
+    const uintptr_t c = reinterpret_cast<uintptr_t>(car);
+    int kind = -1;
+    if (!rd(c + kForzaCarKindOffset, &kind, 4)) return;
+    if (kind == 0) cs_player_car();
+    // Every other car is asked: its kind doesn't tell another player's car apart (2 or 5 in a player-hosted world, 3 in
+    // an official one); the hook answers only for the car it matched to another player.
+    else if (kind != 0 && g_cs_on.load(std::memory_order_acquire)) cs_remote_car(c);
+}
+
 void detour_car_update(void* car, float dt, float b, uint32_t flag) {
     g_orig_car_update(car, dt, b, flag);
     if (note_car(car) && dt > 0.0f && dt < 0.25f) {
         g_game_us.fetch_add(uint64_t(double(dt) * 1e6), std::memory_order_relaxed);
         g_game_moved.store(GetTickCount64(), std::memory_order_relaxed);
     }
+    cs_car(car);
 }
 
